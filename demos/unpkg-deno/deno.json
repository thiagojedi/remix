{
  "tasks": {
    "dev": {
      "description": "Run server code (no compilation) in watch mode",
      "command": "deno serve -P --port 44100 --ignore-env --watch fetch.ts"
    },
    "start": {
      "description": "Runs serve using Deno.server built-in api.",
      "command": "deno run -P --ignore-env server.ts"
    },
    "start:fetch": {
      "description": "Runs serve using Fetch api.",
      "command": "deno serve --port 44100 -P --ignore-env fetch.ts"
    }
  },
  "permissions": {
    "default": {
      "env": ["NODE_ENV", "PORT"],
      "read": ["/tmp/unpkg-cache"],
      "write": ["/tmp/unpkg-cache"],
      "net": ["registry.npmjs.org", "0.0.0.0"]
    }
  }
}
