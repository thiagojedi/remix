{
  "tasks": {
    "dev": {
      "description": "Run server code (no compilation) in watch mode",
      "command": "deno serve -P --port 44100 --ignore-env --watch deno.entry.ts"
    },
    "start": {
      "description": "Runs serve using Fetch api.",
      "command": "deno serve --port 44100 -P --ignore-env deno.entry.ts"
    },
    "typecheck": {
      "description": "Check types using tsgo",
      "command": "deno check --unstable-tsgo"
    }
  },
  "permissions": {
    "default": {
      "env": ["NODE_ENV", "PORT"],
      "read": ["/tmp/unpkg-cache"],
      "write": ["/tmp/unpkg-cache"],
      "net": ["registry.npmjs.org", "0.0.0.0"]
    }
  },
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
