{
  "tasks": {
    "dev": {
      "description": "Use this for development. Setups server and browser in parallel.",
      "dependencies": ["dev:server", "dev:browser"]
    },
    "dev:server": {
      "description": "Run server code (no compilation) in watch mode",
      "command": "NODE_ENV=development deno run --permission-set=dev-env --ignore-env --watch server.ts"
    },
    "dev:browser": {
      "description": "Compiles assets to public folder",
      "command": "deno bundle ../frames/app/assets/*.tsx --outdir=public/assets --minify --code-splitting --platform=browser --sourcemap --watch"
    },
    "start": {
      "description": "Runs serve using Fetch api. Expects compiled assets (see dev:browser).",
      "command": "deno serve --port 44100 --permission-set=public --ignore-env deno.entry.ts"
    },
    "typecheck": {
      "description": "Check types using typescript-go (unstable)",
      "command": "deno check --unstable-tsgo"
    }
  },
  "permissions": {
    "public": {
      "read": ["public/"]
    },
    "public-with-net": {
      "read": ["public/"],
      "net": true
    },
    "dev-env": {
      "env": ["NODE_ENV"],
      "read": ["public/"],
      "net": true
    }
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "remix/component"
  },
  "lint": {
    "rules": {
      "exclude": [
        "prefer-const",
        "no-explicit-any",
        "require-await"
      ]
    }
  }
}
